---
// Pricing section component

// Business segment plans
const businessPlans = [
  {
    name: "Basic",
    description: "Ideal for individuals and small businesses",
    price: "49",
    priceUnit: "mes",
    features: [
      "1 user",
      "Up to 3 connections to databases",
      "Unlimited queries",
      "Community Support",
      "5,000 free tokens/month",
      "Free Trial 7 days",
    ],
    buttonText: "Start Free Trial",
    popular: false,
    segment: "business",
  },
  {
    name: "Pro",
    description: "For growing teams",
    price: "99",
    priceUnit: "user/month",
    features: [
      "Multiuser",
      "Unlimited connections to databases",
      "Unlimited queries",
      "1 custom demo included",
      "Priority support",
      "Usage analytics",
      "50,000 free tokens/month",
    ],
    buttonText: "Start Free Trial",
    popular: true,
    segment: "business",
  },
  {
    name: "Enterprise",
    description: "Solutions for large organizations",
    price: null,
    priceUnit: "custom",
    features: [
      "Guaranteed SLA",
      "Custom ERP integration",
      "Personalized training",
      "Pricing based on volume and tokens",
      "Custom deployment options",
      "Dedicated support team",
    ],
    buttonText: "Contact Sales",
    popular: false,
    segment: "business",
  },
];

// ERP segment - custom pricing
const erpPricing = {
  name: "ERP",
  description: "Custom solution with optimized model",
  tokenPricing: {
    input: "1.075",
    cached: "0.108",
    output: "8.600",
  },
  features: [
    "Continuous maintenance",
    "Permanent model optimization",
    "Dedicated support",
    "Guaranteed scalability",
    "Dedicated API",
    "Custom integration",
    "Guaranteed SLA",
  ],
};
---

<section
  id="pricing"
  class="relative isolate bg-gradient-to-b from-white/80 to-white px-6 py-20 lg:px-8 -mt-10"
>
  <div
    class="absolute inset-x-0 -top-3 -z-10 transform-gpu overflow-hidden px-36 blur-3xl"
    aria-hidden="true"
  >
    <div
      class="mx-auto aspect-[1155/678] w-[72.1875rem] bg-gradient-to-tr from-primary to-tech opacity-10"
      style="clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)"
    >
    </div>
  </div>

  <div class="text-center mb-16">
    <span
      class="inline-block px-4 py-2 rounded-full bg-tech/10 text-tech font-medium text-sm mb-4 font-secondary animate-pulse"
    >
      Coming Soon
    </span>
    <h2 class="text-3xl font-bold mb-4 text-text font-primary">
      Transparent and Scalable Pricing
    </h2>
    <p class="text-gray-600 max-w-2xl mx-auto font-secondary mb-2">
      Choose the plan that best fits your needs. Pay only for what you use.
    </p>
  </div>

  <!-- Business Plans -->
  <div class="mb-20">
    <div
      class="mx-auto grid max-w-7xl grid-cols-1 items-center gap-8 lg:grid-cols-3"
    >
      {
        businessPlans.map((plan) => (
          <div
            class={`rounded-3xl relative transition-all duration-300 ${
              plan.popular
                ? "p-8 bg-white shadow-2xl scale-105 z-10 border-2 border-tech/20"
                : "p-6 bg-white/80 backdrop-blur-sm shadow-lg hover:shadow-xl border border-tech/10"
            }`}
          >
            {plan.popular && (
              <div class="absolute -top-5 left-0 right-0 mx-auto w-fit">
                <span class="bg-gradient-to-r from-primary to-tech text-white text-sm font-semibold px-4 py-1 rounded-full font-secondary">
                  Most Popular
                </span>
              </div>
            )}

            <div class="text-center mb-8">
              <h3
                class={`font-primary font-bold mb-2 ${plan.popular ? "text-2xl text-text" : "text-xl text-text"}`}
              >
                {plan.name}
              </h3>
              <p class="text-gray-600 font-secondary mb-6">
                {plan.description}
              </p>

              {plan.price ? (
                <div class="mb-2">
                  <div class="flex items-baseline justify-center gap-1">
                    <span
                      class={`font-bold ${plan.popular ? "text-4xl text-tech" : "text-3xl text-tech"}`}
                    >
                      €{plan.price}
                    </span>
                    <span class="text-gray-500 font-secondary text-sm">
                      /{plan.priceUnit}
                    </span>
                  </div>
                </div>
              ) : (
                <div class="font-bold text-3xl text-text mb-2">
                  Custom Pricing
                </div>
              )}
            </div>

            <ul class="space-y-4 mb-8">
              {plan.features.map((feature) => (
                <li class="flex items-center text-gray-600 font-secondary">
                  <svg
                    class="w-5 h-5 text-primary mr-3 flex-shrink-0"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M5 13l4 4L19 7"
                    />
                  </svg>
                  {feature}
                </li>
              ))}
            </ul>

            <a
              href="/signup"
              class={`w-full py-3 px-6 rounded-xl transition-all duration-300 font-secondary block text-center ${
                plan.popular
                  ? "bg-gradient-to-r from-primary to-tech text-white hover:shadow-lg hover:shadow-tech/20"
                  : "bg-tech/10 text-tech hover:bg-tech/20"
              }`}
            >
              {plan.buttonText}
            </a>
          </div>
        ))
      }
    </div>
  </div>

  <!-- API Cost Information -->
  <div class="mb-16">
    <h3 class="text-2xl font-bold text-center mb-2 text-text font-primary">
      API Cost
    </h3>
    <p class="text-center text-gray-600 font-secondary mb-12 max-w-2xl mx-auto">
      Price per token consumption
    </p>

    <div class="mx-auto max-w-3xl">
      <div
        class="rounded-3xl p-8 bg-gradient-to-br from-tech/5 to-primary/5 border-2 border-tech/20 shadow-xl"
      >
        <div class="bg-white/80 rounded-xl p-6">
          <div class="grid grid-cols-3 gap-6">
            <div class="text-center">
              <div class="text-tech font-bold text-2xl">
                €{erpPricing.tokenPricing.input}
              </div>
              <div class="text-gray-500 font-secondary text-sm mt-1">
                Input / 1M tokens
              </div>
            </div>
            <div class="text-center">
              <div class="text-tech font-bold text-2xl">
                €{erpPricing.tokenPricing.cached}
              </div>
              <div class="text-gray-500 font-secondary text-sm mt-1">
                Cached / 1M tokens
              </div>
            </div>
            <div class="text-center">
              <div class="text-tech font-bold text-2xl">
                €{erpPricing.tokenPricing.output}
              </div>
              <div class="text-gray-500 font-secondary text-sm mt-1">
                Output / 1M tokens
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Pricing Explanation -->
  <div class="mx-auto mt-16 max-w-4xl">
    <div
      class="bg-gradient-to-r from-tech/5 to-primary/5 rounded-2xl p-8 border border-tech/10"
    >
      <div class="flex items-start gap-4">
        <div class="flex-shrink-0">
          <div
            class="w-12 h-12 rounded-full bg-tech/10 flex items-center justify-center"
          >
            <svg
              class="w-6 h-6 text-tech"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
              ></path>
            </svg>
          </div>
        </div>
        <div class="flex-1">
          <h3 class="text-lg font-bold text-gray-900 mb-2 font-primary">
            How Does Our Pricing Model Work?
          </h3>
          <p class="text-gray-600 mb-4 font-secondary">
            We offer two segments adapted to different needs: business solutions
            with fixed plans and custom ERP solutions with a scalable
            token-based model.
          </p>
          <div class="grid md:grid-cols-3 gap-4 text-sm">
            <div class="flex items-start gap-2">
              <svg
                class="w-5 h-5 text-primary flex-shrink-0 mt-0.5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 13l4 4L19 7"></path>
              </svg>
              <span class="text-gray-600 font-secondary"
                >Pay only for actual usage</span
              >
            </div>
            <div class="flex items-start gap-2">
              <svg
                class="w-5 h-5 text-primary flex-shrink-0 mt-0.5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 13l4 4L19 7"></path>
              </svg>
              <span class="text-gray-600 font-secondary"
                >Guaranteed scalability</span
              >
            </div>
            <div class="flex items-start gap-2">
              <svg
                class="w-5 h-5 text-primary flex-shrink-0 mt-0.5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 13l4 4L19 7"></path>
              </svg>
              <span class="text-gray-600 font-secondary">No hidden costs</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
