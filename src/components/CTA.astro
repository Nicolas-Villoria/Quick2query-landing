---
import BackgroundGradient from "./BackgroundGradient";
// Call to Action section component
---

<section id="contact" class="relative isolate section-padding bg-white">
  <BackgroundGradient />
  <div class="container-custom text-center">
    <!-- Framed CTA Content -->
    <div class="max-w-6xl mx-auto bg-white/90 backdrop-blur-sm rounded-3xl ring-1 ring-tech/20 shadow-xl p-12 lg:p-16">
      <h2 class="text-4xl lg:text-7xl font-bold mb-8 font-primary bg-gradient-to-r text-indigo-950 bg-clip-text">
        Ready to Unlock Your Data's Potential?
      </h2>
      <p class="text-xl lg:text-2xl text-text mb-12 max-w-3xl mx-auto leading-relaxed font-secondary">
        <span class="text-tech font-semibold">Focus on insights</span>, not syntax. Join our waitlist to get early access when Quick2query launches, be among the first to transform how your team interacts with data.
      </p>
      <div class="flex flex-col lg:flex-row gap-6 justify-center items-center">
        <a href="/signup" class="px-10 py-4 rounded-2xl transition-all duration-300 font-semibold bg-gradient-to-r from-primary to-tech text-white hover:from-tech hover:to-primary shadow-lg shadow-primary/20 hover:shadow-xl hover:shadow-tech/20 text-lg">
          Join Waitlist
        </a>
        <a href="/contact" class="px-10 py-4 rounded-2xl transition-all duration-300 font-semibold bg-white text-tech hover:bg-tech/5 shadow hover:shadow-lg border-2 border-tech/20 hover:border-tech text-lg">
          Request Demo
        </a>
      </div>
    </div>
  </div>
</section>
