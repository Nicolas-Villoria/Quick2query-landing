---
// FeatureGrid.astro
const features = [
  {
    title: 'Database Adaptability',
    description: 'Seamlessly supports multiple database systems including MySQL, PostgreSQL, SQL Server, and SQLite for versatile application.'
  },
  {
    title: 'Flexible Integration',
    description: 'Easy-to-integrate RESTful API with support for multiple databases and customizable response formats.'
  },
  {
    title: 'Advanced Security',
    description: 'Robust data protection with end-to-end encryption, granular access controls, and comprehensive query auditing.'
  },
  {
    title: 'Query Optimization',
    description: 'AI engine that generates optimized SQL queries for maximum performance and efficiency in databases of any size.'
  },
  {
    title: 'Contextual Analysis',
    description: 'Deep understanding of business context to generate precise queries that exactly meet user needs.'
  },
  {
    title: 'Interactive Documentation',
    description: 'Comprehensive documentation with practical examples, interactive playground, and step-by-step integration guides.'
  }
];
---

<section id="features" class="feature-grid py-24 bg-white">
    <div class="container mx-auto px-4 sm:px-6">
      <div class="text-center mb-20">
          <h2 class="text-4xl lg:text-5xl font-bold text-indigo-950 mb-6">Enterprise-Grade Text-to-SQL</h2>
          <p class="text-xl text-gray-600 max-w-3xl mx-auto leading-relaxed">
              Production-ready API that transforms natural language into optimized database queries for modern data teams.
          </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-6xl mx-auto">
        {features.map(f => (
          <div class="feature-card p-8 bg-white border-2 border-gray-200 rounded-xl hover:border-tech/40 transition-all duration-300">
            <h3 class="text-xl font-bold text-gray-900 mb-3">{f.title}</h3>
            <p class="text-gray-600 leading-relaxed">{f.description}</p>
          </div>
        ))}
      </div>
    </div>
</section>
